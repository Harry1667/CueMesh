# 對外服務連接埠（只綁定 127.0.0.1，由 Nginx 轉發）
HOST_PORT=3000

# PostgreSQL 密碼，只用英數字，例如 openssl rand -hex 24 的結果。資料庫不對主機開放連接埠。
POSTGRES_PASSWORD=change-me

# 允許的網站 Origin，逗號分隔。Chrome 擴充功能的 Origin 會自動允許。
WEBSITE_ORIGINS=https://app.example.com

# 反向代理的層數。經過一層本機 Nginx 就設 1；不要設 true，那會相信客戶端自己傳的 X-Forwarded-For，讓限流可以被繞過。
TRUST_PROXY=false
